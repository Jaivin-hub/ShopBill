# Vite (not CRA): use VITE_* variables. REACT_APP_API_URL is ignored at build time.
# Copy to .env.local or set in your host (Netlify/Vercel/CI/AWS).
#
# API base MUST include /api (paths in code are like /auth/login relative to this).
# Do not use :5000; use HTTPS on 443 only.
VITE_API_BASE_URL=https://server.pocketpos.io/api
#
# Socket.IO: HTTPS origin only, no path, no port. Nginx should proxy /socket.io to Node.
VITE_SOCKET_URL=https://server.pocketpos.io

# Firebase Web (FCM push). VAPID is required or the app will not register for push.
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
